<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" prefWidth="1080" prefHeight="780" styleClass="app" stylesheets="@uber.css">
    <ScrollPane fitToWidth="true" styleClass="auth-scroll">
        <content>
            <VBox alignment="CENTER" spacing="24" styleClass="auth-wrap">
                <Label text="%vista.sistema.uber" styleClass="brand" wrapText="true"/>
                <VBox spacing="16" styleClass="auth-card">
                    <Label text="%vista.crea.tu.cuenta" styleClass="title" wrapText="true"/>
                    <Label text="%vista.con.una.cuenta.podes.viajar.y.tambien" styleClass="muted" wrapText="true"/>
                    <VBox spacing="16" styleClass="field-group" HBox.hgrow="ALWAYS" minWidth="0">
                        <Label text="%vista.nombre.completo" styleClass="field-label" wrapText="true"/>
                        <TextField fx:id="nombre" promptText="%vista.tu.nombre.y.apellido" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="16" styleClass="field-group" HBox.hgrow="ALWAYS" minWidth="0">
                        <Label text="%vista.telefono" styleClass="field-label" wrapText="true"/>
                        <TextField fx:id="telefono" promptText="%vista.ej.5492804000000" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="16" styleClass="field-group" HBox.hgrow="ALWAYS" minWidth="0">
                        <Label text="%vista.correo.electronico" styleClass="field-label" wrapText="true"/>
                        <TextField fx:id="correoRegistro" promptText="%vista.nombre.ejemplo.com" maxWidth="Infinity"/>
                    </VBox>
                    <Button text="%vista.crear.cuenta.y.entrar" onAction="#registrarUsuario" styleClass="primary"/>
                    <Button text="%vista.volver.al.inicio" onAction="#abrirInicio" styleClass="secondary"/>
                    <Label text="" styleClass="feedback" wrapText="true" fx:id="mensaje"/>
                </VBox>
                <Label text="%vista.proyecto.academico.acceso.por.correo.registrado.sin" styleClass="small" wrapText="true"/>
            </VBox>
        </content>
    </ScrollPane>
</StackPane>