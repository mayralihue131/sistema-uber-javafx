<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <ScrollPane fitToWidth="true">
        <content>
            <VBox alignment="CENTER" spacing="16">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                <VBox spacing="12" maxWidth="360">
                    <Label text="%vista.crea.tu.cuenta" style="-fx-text-fill: #1565c0; -fx-font-size: 24px; -fx-font-weight: bold;" wrapText="true"/>
                    <Label text="%vista.con.una.cuenta.podes.viajar.y.tambien" wrapText="true"/>
                    <VBox spacing="16" HBox.hgrow="ALWAYS" minWidth="0">
                        <Label text="%vista.nombre.completo" wrapText="true"/>
                        <TextField fx:id="nombre" promptText="%vista.tu.nombre.y.apellido" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="16" HBox.hgrow="ALWAYS" minWidth="0">
                        <Label text="%vista.telefono" wrapText="true"/>
                        <TextField fx:id="telefono" promptText="%vista.ej.5492804000000" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="16" HBox.hgrow="ALWAYS" minWidth="0">
                        <Label text="%vista.correo.electronico" wrapText="true"/>
                        <TextField fx:id="correoRegistro" promptText="%vista.nombre.ejemplo.com" maxWidth="Infinity"/>
                    </VBox>
                    <Button text="%vista.crear.cuenta.y.entrar" onAction="#registrarUsuario"/>
                    <Button text="%vista.volver.al.inicio" onAction="#abrirInicio"/>
                    <Label text="" wrapText="true" fx:id="mensaje"/>
                </VBox>
                <Label text="%vista.proyecto.academico.acceso.por.correo.registrado.sin" wrapText="true"/>
            </VBox>
        </content>
    </ScrollPane>
</StackPane>