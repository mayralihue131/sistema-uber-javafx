<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" prefWidth="1080" prefHeight="780" styleClass="app" stylesheets="@uber.css"><ScrollPane fitToWidth="true" styleClass="auth-scroll"><content><VBox alignment="CENTER" spacing="24" styleClass="auth-wrap"><Label text="SISTEMA UBER" styleClass="brand" wrapText="true"/><VBox spacing="16" styleClass="auth-card"><Label text="Creá tu cuenta" styleClass="title" wrapText="true"/><Label text="Con una cuenta podés viajar y también habilitarte como conductor." styleClass="muted" wrapText="true"/><VBox spacing="16" styleClass="field-group" HBox.hgrow="ALWAYS" minWidth="0"><Label text="Nombre completo" styleClass="field-label" wrapText="true"/><TextField fx:id="nombre" promptText="Tu nombre y apellido" maxWidth="Infinity"/></VBox><VBox spacing="16" styleClass="field-group" HBox.hgrow="ALWAYS" minWidth="0"><Label text="Teléfono" styleClass="field-label" wrapText="true"/><TextField fx:id="telefono" promptText="Ej.: +5492804000000" maxWidth="Infinity"/></VBox><VBox spacing="16" styleClass="field-group" HBox.hgrow="ALWAYS" minWidth="0"><Label text="Correo electrónico" styleClass="field-label" wrapText="true"/><TextField fx:id="correoRegistro" promptText="nombre@ejemplo.com" maxWidth="Infinity"/></VBox><Button text="Crear cuenta y entrar" onAction="#registrarUsuario" styleClass="primary"/><Button text="Volver al inicio" onAction="#abrirInicio" styleClass="secondary"/><Label text="" styleClass="feedback" wrapText="true" fx:id="mensaje"/></VBox><Label text="Proyecto académico · Acceso por correo registrado, sin contraseña" styleClass="small" wrapText="true"/></VBox></content></ScrollPane></StackPane>