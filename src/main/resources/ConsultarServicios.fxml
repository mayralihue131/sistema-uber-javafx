<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      prefWidth="650"
      prefHeight="650"
      spacing="10">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="%vista.servicios.disponibles"
           style="-fx-text-fill: #1565c0; -fx-font-size: 24px; -fx-font-weight: bold;"
           wrapText="true"/>

    <Label text="%vista.tipo.de.servicio"/>
    <ComboBox fx:id="tipoServicio" maxWidth="Infinity"/>

    <Label text="%vista.categoria"/>
    <ComboBox fx:id="categoria" maxWidth="Infinity"/>

    <Button text="%vista.consultar.servicios" onAction="#buscarServicios"/>

    <ListView fx:id="listaServicios" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label text="%vista.elegi.los.filtros.y.consulta" wrapText="true"/>
        </placeholder>
    </ListView>

    <Label fx:id="mensaje" wrapText="true"/>

    <Button text="%vista.volver.al.menu" onAction="#abrirMenu"/>
</VBox>