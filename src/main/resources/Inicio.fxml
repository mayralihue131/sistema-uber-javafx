<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="650"
            prefHeight="650"
            fitToWidth="true">

    <content>
        <VBox alignment="TOP_CENTER" spacing="16">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="%vista.sistema.uber"
                   style="-fx-text-fill: #1565c0; -fx-font-size: 24px; -fx-font-weight: bold;"
                   wrapText="true"/>

            <VBox spacing="8" maxWidth="360">
                <Label text="%inicio.idioma"/>
                <ComboBox fx:id="selectorIdioma"
                          accessibleText="%inicio.idioma"
                          maxWidth="Infinity"/>

                <Label text="%vista.correo.electronico"/>
                <TextField fx:id="campoCorreo"
                           promptText="%vista.nombre.ejemplo.com"
                           maxWidth="Infinity"/>

                <Button text="%vista.continuar"
                        onAction="#ingresar"/>

                <Button text="%vista.crear.una.cuenta"
                        onAction="#abrirRegistroUsuario"/>

                <Label fx:id="mensaje" wrapText="true"/>
            </VBox>

            <Label text="%vista.proyecto.academico.acceso.por.correo.registrado.sin"
                   wrapText="true"/>
        </VBox>
    </content>
</ScrollPane>