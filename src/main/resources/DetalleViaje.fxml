<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">

    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="10">
                    <padding>
                        <Insets top="16" right="20" bottom="16" left="20"/>
                    </padding>

                    <Label text="%vista.detalle.del.viaje"
                           style="-fx-text-fill: #1565c0; -fx-font-size: 24px; -fx-font-weight: bold;"
                           wrapText="true"/>

                    <Label fx:id="tituloEstado" wrapText="true"/>
                    <Label fx:id="datosServicio" wrapText="true"/>
                    <Label fx:id="precioViaje" wrapText="true"/>
                    <Label fx:id="datosParticipantes" wrapText="true"/>

                    <Label fx:id="estadoViaje" visible="false" managed="false"/>
                    <Label fx:id="explicacionEstado" visible="false" managed="false"/>
                    <Label fx:id="idViaje" visible="false" managed="false"/>
                    <ProgressBar fx:id="progreso" visible="false" managed="false"/>
                    <Label fx:id="rutaViaje" visible="false" managed="false"/>

                    <StackPane prefHeight="260" minHeight="200"
                               style="-fx-border-color: #cbd5e1; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-overflow: hidden;">
                        <WebView fx:id="mapaWeb" prefHeight="260" minHeight="200"/>
                    </StackPane>

                    <FlowPane hgap="8" vgap="8">
                        <Button fx:id="btnIniciar"
                                text="%vista.iniciar.traslado"
                                onAction="#iniciarViaje"/>
                        <Button fx:id="btnFinalizar"
                                text="%vista.finalizar.viaje"
                                onAction="#finalizarViaje"/>
                        <Button text="%vista.actualizar.estado"
                                onAction="#actualizarDetalle"/>
                    </FlowPane>

                    <VBox fx:id="bloqueCancelar">
                        <TitledPane text="%vista.cancelar.solicitud.o.viaje" expanded="false">
                            <content>
                                <VBox spacing="8">
                                    <Label text="%vista.antes.de.la.aceptacion.es.gratis.despues"
                                           wrapText="true"/>
                                    <TextField fx:id="motivoCancelacion"
                                               promptText="%vista.escribi.el.motivo.de.cancelacion"/>
                                    <TextField fx:id="kmRecorridos"
                                               promptText="%vista.kilometros.recorridos.hasta.cancelar.ej.0"/>
                                    <Button fx:id="btnCancelar"
                                            text="%vista.revisar.cargo.y.cancelar"
                                            onAction="#cancelarViaje"/>
                                </VBox>
                            </content>
                        </TitledPane>
                    </VBox>

                    <VBox fx:id="bloqueCalificar" spacing="8">
                        <Label text="%vista.tu.calificacion" wrapText="true"/>
                        <ComboBox fx:id="calificacion"
                                  promptText="%vista.elegi.una.calificacion"/>
                        <Button fx:id="btnCalificar"
                                text="%vista.guardar.mi.calificacion"
                                onAction="#calificar"/>
                        <Label fx:id="miCalificacion" wrapText="true"/>
                    </VBox>

                    <TitledPane text="%vista.historial.del.viaje" expanded="false">
                        <content>
                            <ListView fx:id="historial" prefHeight="120">
                                <placeholder>
                                    <Label text="%vista.sin.movimientos" wrapText="true"/>
                                </placeholder>
                            </ListView>
                        </content>
                    </TitledPane>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <Label fx:id="mensaje" wrapText="true" maxWidth="Infinity">
            <BorderPane.margin>
                <Insets top="4" right="20" bottom="8" left="20"/>
            </BorderPane.margin>
        </Label>
    </bottom>

</BorderPane>