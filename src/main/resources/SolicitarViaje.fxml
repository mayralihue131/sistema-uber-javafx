<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" prefWidth="1080" prefHeight="780" styleClass="app" stylesheets="@uber.css">
    <top>
        <HBox spacing="16" alignment="CENTER_LEFT" styleClass="topbar">
            <Label text="%vista.sistema.uber" styleClass="brand" wrapText="true"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="" styleClass="user" wrapText="true" fx:id="nombreSesion"/>
            <Button text="%vista.cambiar.cuenta" onAction="#cerrarSesion" styleClass="secondary"/>
        </HBox>
    </top>
    <left>
        <VBox spacing="8" prefWidth="196" styleClass="sidebar">
            <Label text="%vista.tu.espacio" styleClass="eyebrow" wrapText="true"/>
            <Button text="%vista.inicio" onAction="#abrirMenu" styleClass="nav"/>
            <Button text="%vista.solicitar.viaje" onAction="#abrirSolicitud" styleClass="nav"/>
            <Button text="%vista.servicios" onAction="#abrirServicios" styleClass="nav"/>
            <Button text="%vista.mis.viajes" onAction="#abrirViajes" styleClass="nav"/>
            <Button text="%vista.panel.conductor" onAction="#abrirPanel" styleClass="nav"/>
            <Button text="%vista.mis.vehiculos" onAction="#abrirRegistroConductor" styleClass="nav"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="%vista.tus.viajes.quedan.guardados.al.cerrar" styleClass="small" wrapText="true"/>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="20" styleClass="page">
                    <Label text="%vista.solicitar.viaje" styleClass="title" wrapText="true"/>
                    <Label text="%vista.elegi.el.recorrido.compara.el.precio.estimado" styleClass="muted" wrapText="true"/>
                    <VBox spacing="16" styleClass="card">
                        <Label text="%vista.1.tu.recorrido" styleClass="section" wrapText="true"/>
                        <Label text="%vista.los.lugares.son.puntos.de.demostracion.con" styleClass="small" wrapText="true"/>
                        <VBox spacing="16" styleClass="field-group" HBox.hgrow="ALWAYS" minWidth="0">
                            <Label text="%vista.origen" styleClass="field-label" wrapText="true"/>
                            <ComboBox fx:id="origenLugar" promptText="%vista.elegi.un.lugar" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="16" styleClass="field-group" HBox.hgrow="ALWAYS" minWidth="0">
                            <Label text="%vista.destino" styleClass="field-label" wrapText="true"/>
                            <ComboBox fx:id="destinoLugar" promptText="%vista.elegi.un.lugar" maxWidth="Infinity"/>
                        </VBox>
                        <CheckBox fx:id="manual" text="%vista.ingresar.coordenadas.manualmente" onAction="#cambiarModo"/>
                        <VBox fx:id="coordenadas" spacing="16" styleClass="coordinates">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <VBox spacing="16" styleClass="field-group" HBox.hgrow="ALWAYS" minWidth="0">
                                    <Label text="%vista.latitud.origen" styleClass="field-label" wrapText="true"/>
                                    <TextField fx:id="latitudOrigen" promptText="-42.77" maxWidth="Infinity"/>
                                </VBox>
                                <VBox spacing="16" styleClass="field-group" HBox.hgrow="ALWAYS" minWidth="0">
                                    <Label text="%vista.longitud.origen" styleClass="field-label" wrapText="true"/>
                                    <TextField fx:id="longitudOrigen" promptText="-65.04" maxWidth="Infinity"/>
                                </VBox>
                            </HBox>
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <VBox spacing="16" styleClass="field-group" HBox.hgrow="ALWAYS" minWidth="0">
                                    <Label text="%vista.latitud.destino" styleClass="field-label" wrapText="true"/>
                                    <TextField fx:id="latitudDestino" promptText="-42.78" maxWidth="Infinity"/>
                                </VBox>
                                <VBox spacing="16" styleClass="field-group" HBox.hgrow="ALWAYS" minWidth="0">
                                    <Label text="%vista.longitud.destino" styleClass="field-label" wrapText="true"/>
                                    <TextField fx:id="longitudDestino" promptText="-65.02" maxWidth="Infinity"/>
                                </VBox>
                            </HBox>
                        </VBox>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <VBox spacing="16" styleClass="field-group" HBox.hgrow="ALWAYS" minWidth="0">
                                <Label text="%vista.tipo.de.servicio" styleClass="field-label" wrapText="true"/>
                                <ComboBox fx:id="tipoServicio" promptText="%vista.selecciona" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="16" styleClass="field-group" HBox.hgrow="ALWAYS" minWidth="0">
                                <Label text="%vista.categoria" styleClass="field-label" wrapText="true"/>
                                <ComboBox fx:id="categoria" promptText="%vista.selecciona" maxWidth="Infinity"/>
                            </VBox>
                        </HBox>
                        <Button text="%vista.buscar.opciones" onAction="#buscarOpciones" styleClass="primary"/>
                    </VBox>
                    <VBox spacing="16" styleClass="card">
                        <Label text="%vista.2.elegi.tu.servicio" styleClass="section" wrapText="true"/>
                        <ListView fx:id="opciones" prefHeight="200">
                            <placeholder>
                                <Label text="%vista.completa.el.recorrido.y.toca.buscar.opciones" styleClass="muted" wrapText="true"/>
                            </placeholder>
                        </ListView>
                        <Label text="%vista.el.precio.y.el.tiempo.son.estimados" styleClass="small" wrapText="true"/>
                        <Button text="%vista.confirmar.viaje.seleccionado" onAction="#confirmarViaje" styleClass="primary" fx:id="btnConfirmar"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <Label text="" styleClass="feedback" wrapText="true" fx:id="mensaje" maxWidth="Infinity"/>
    </bottom>
</BorderPane>