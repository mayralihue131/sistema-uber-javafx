<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="12">
                    <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                    <Label text="%vista.solicitar.viaje" style="-fx-text-fill: #1565c0; -fx-font-size: 24px; -fx-font-weight: bold;" wrapText="true"/>
                    <Label text="%vista.elegi.el.recorrido.compara.el.precio.estimado" wrapText="true"/>
                    <VBox spacing="8">
                        <Label text="%vista.1.tu.recorrido" wrapText="true"/>
                        <Label text="%vista.los.lugares.son.puntos.de.demostracion.con" wrapText="true"/>
                        <VBox spacing="16" HBox.hgrow="ALWAYS" minWidth="0">
                            <Label text="%vista.origen" wrapText="true"/>
                            <ComboBox fx:id="origenLugar" promptText="%vista.elegi.un.lugar" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="16" HBox.hgrow="ALWAYS" minWidth="0">
                            <Label text="%vista.destino" wrapText="true"/>
                            <ComboBox fx:id="destinoLugar" promptText="%vista.elegi.un.lugar" maxWidth="Infinity"/>
                        </VBox>
                        <CheckBox fx:id="manual" text="%vista.ingresar.coordenadas.manualmente" onAction="#cambiarModo"/>
                        <VBox fx:id="coordenadas" spacing="16">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <VBox spacing="16" HBox.hgrow="ALWAYS" minWidth="0">
                                    <Label text="%vista.latitud.origen" wrapText="true"/>
                                    <TextField fx:id="latitudOrigen" promptText="-42.77" maxWidth="Infinity"/>
                                </VBox>
                                <VBox spacing="16" HBox.hgrow="ALWAYS" minWidth="0">
                                    <Label text="%vista.longitud.origen" wrapText="true"/>
                                    <TextField fx:id="longitudOrigen" promptText="-65.04" maxWidth="Infinity"/>
                                </VBox>
                            </HBox>
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <VBox spacing="16" HBox.hgrow="ALWAYS" minWidth="0">
                                    <Label text="%vista.latitud.destino" wrapText="true"/>
                                    <TextField fx:id="latitudDestino" promptText="-42.78" maxWidth="Infinity"/>
                                </VBox>
                                <VBox spacing="16" HBox.hgrow="ALWAYS" minWidth="0">
                                    <Label text="%vista.longitud.destino" wrapText="true"/>
                                    <TextField fx:id="longitudDestino" promptText="-65.02" maxWidth="Infinity"/>
                                </VBox>
                            </HBox>
                        </VBox>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <VBox spacing="16" HBox.hgrow="ALWAYS" minWidth="0">
                                <Label text="%vista.tipo.de.servicio" wrapText="true"/>
                                <ComboBox fx:id="tipoServicio" promptText="%vista.selecciona" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="16" HBox.hgrow="ALWAYS" minWidth="0">
                                <Label text="%vista.categoria" wrapText="true"/>
                                <ComboBox fx:id="categoria" promptText="%vista.selecciona" maxWidth="Infinity"/>
                            </VBox>
                        </HBox>
                        <Button text="%vista.buscar.opciones" onAction="#buscarOpciones"/>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="%vista.2.elegi.tu.servicio" wrapText="true"/>
                        <ListView fx:id="opciones" prefHeight="200">
                            <placeholder>
                                <Label text="%vista.completa.el.recorrido.y.toca.buscar.opciones" wrapText="true"/>
                            </placeholder>
                        </ListView>
                        <Label text="%vista.el.precio.y.el.tiempo.son.estimados" wrapText="true"/>
                        <Button text="%vista.confirmar.viaje.seleccionado" onAction="#confirmarViaje" fx:id="btnConfirmar"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <Label text="" wrapText="true" fx:id="mensaje" maxWidth="Infinity">
            <BorderPane.margin><Insets top="4" right="20" bottom="8" left="20"/></BorderPane.margin>
        </Label>
    </bottom>
</BorderPane>