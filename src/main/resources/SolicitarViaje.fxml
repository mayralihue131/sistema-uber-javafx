<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" prefWidth="1080" prefHeight="780" styleClass="app" stylesheets="@uber.css">
 <top><HBox spacing="16" alignment="CENTER_LEFT" styleClass="topbar"><Label text="SISTEMA UBER" styleClass="brand" wrapText="true"/><Region HBox.hgrow="ALWAYS"/><Label text="" styleClass="user" wrapText="true" fx:id="nombreSesion"/><Button text="Cambiar cuenta" onAction="#cerrarSesion" styleClass="secondary"/></HBox></top>
 <left><VBox spacing="8" prefWidth="196" styleClass="sidebar"><Label text="TU ESPACIO" styleClass="eyebrow" wrapText="true"/><Button text="Inicio" onAction="#abrirMenu" styleClass="nav"/><Button text="Solicitar viaje" onAction="#abrirSolicitud" styleClass="nav"/><Button text="Servicios" onAction="#abrirServicios" styleClass="nav"/><Button text="Mis viajes" onAction="#abrirViajes" styleClass="nav"/><Button text="Panel conductor" onAction="#abrirPanel" styleClass="nav"/><Button text="Mis vehículos" onAction="#abrirRegistroConductor" styleClass="nav"/><Region VBox.vgrow="ALWAYS"/><Label text="Tus viajes quedan guardados al cerrar." styleClass="small" wrapText="true"/></VBox></left>
 <center><ScrollPane fitToWidth="true"><content><VBox spacing="20" styleClass="page"><Label text="Solicitar viaje" styleClass="title" wrapText="true"/><Label text="Elegí el recorrido, compará el precio estimado y confirmá." styleClass="muted" wrapText="true"/><VBox spacing="16" styleClass="card"><Label text="1 · Tu recorrido" styleClass="section" wrapText="true"/><Label text="Los lugares son puntos de demostración con coordenadas ilustrativas. No hay un mapa ni búsqueda de calles." styleClass="small" wrapText="true"/><VBox spacing="16" styleClass="field-group" HBox.hgrow="ALWAYS" minWidth="0"><Label text="Origen" styleClass="field-label" wrapText="true"/><ComboBox fx:id="origenLugar" promptText="Elegí un lugar" maxWidth="Infinity"/></VBox><VBox spacing="16" styleClass="field-group" HBox.hgrow="ALWAYS" minWidth="0"><Label text="Destino" styleClass="field-label" wrapText="true"/><ComboBox fx:id="destinoLugar" promptText="Elegí un lugar" maxWidth="Infinity"/></VBox><CheckBox fx:id="manual" text="Ingresar coordenadas manualmente" onAction="#cambiarModo"/><VBox fx:id="coordenadas" spacing="16" styleClass="coordinates"><HBox spacing="12" alignment="CENTER_LEFT"><VBox spacing="16" styleClass="field-group" HBox.hgrow="ALWAYS" minWidth="0"><Label text="Latitud origen" styleClass="field-label" wrapText="true"/><TextField fx:id="latitudOrigen" promptText="-42.77" maxWidth="Infinity"/></VBox><VBox spacing="16" styleClass="field-group" HBox.hgrow="ALWAYS" minWidth="0"><Label text="Longitud origen" styleClass="field-label" wrapText="true"/><TextField fx:id="longitudOrigen" promptText="-65.04" maxWidth="Infinity"/></VBox></HBox><HBox spacing="12" alignment="CENTER_LEFT"><VBox spacing="16" styleClass="field-group" HBox.hgrow="ALWAYS" minWidth="0"><Label text="Latitud destino" styleClass="field-label" wrapText="true"/><TextField fx:id="latitudDestino" promptText="-42.78" maxWidth="Infinity"/></VBox><VBox spacing="16" styleClass="field-group" HBox.hgrow="ALWAYS" minWidth="0"><Label text="Longitud destino" styleClass="field-label" wrapText="true"/><TextField fx:id="longitudDestino" promptText="-65.02" maxWidth="Infinity"/></VBox></HBox></VBox><HBox spacing="12" alignment="CENTER_LEFT"><VBox spacing="16" styleClass="field-group" HBox.hgrow="ALWAYS" minWidth="0"><Label text="Tipo de servicio" styleClass="field-label" wrapText="true"/><ComboBox fx:id="tipoServicio" promptText="Seleccioná" maxWidth="Infinity"/></VBox><VBox spacing="16" styleClass="field-group" HBox.hgrow="ALWAYS" minWidth="0"><Label text="Categoría" styleClass="field-label" wrapText="true"/><ComboBox fx:id="categoria" promptText="Seleccioná" maxWidth="Infinity"/></VBox></HBox><Button text="Buscar opciones" onAction="#buscarOpciones" styleClass="primary"/></VBox><VBox spacing="16" styleClass="card"><Label text="2 · Elegí tu servicio" styleClass="section" wrapText="true"/><ListView fx:id="opciones" prefHeight="200"><placeholder><Label text="Completá el recorrido y tocá Buscar opciones." styleClass="muted" wrapText="true"/></placeholder></ListView><Label text="El precio y el tiempo son estimados con distancia directa y velocidad configurada." styleClass="small" wrapText="true"/><Button text="Confirmar viaje seleccionado" onAction="#confirmarViaje" styleClass="primary" fx:id="btnConfirmar"/></VBox></VBox></content></ScrollPane></center><bottom><Label text="" styleClass="feedback" wrapText="true" fx:id="mensaje" maxWidth="Infinity"/></bottom></BorderPane>