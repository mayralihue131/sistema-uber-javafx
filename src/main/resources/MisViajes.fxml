<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" prefWidth="1080" prefHeight="780" styleClass="app" stylesheets="@uber.css">
    <top>
        <HBox spacing="16" alignment="CENTER_LEFT" styleClass="topbar">
            <Label text="%vista.sistema.uber" styleClass="brand" wrapText="true"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="" styleClass="user" wrapText="true" fx:id="nombreSesion"/>
            <Button text="%vista.cambiar.cuenta" onAction="#cerrarSesion" styleClass="secondary"/>
        </HBox>
    </top>
    <left>
        <VBox spacing="8" prefWidth="196" styleClass="sidebar">
            <Label text="%vista.tu.espacio" styleClass="eyebrow" wrapText="true"/>
            <Button text="%vista.inicio" onAction="#abrirMenu" styleClass="nav"/>
            <Button text="%vista.solicitar.viaje" onAction="#abrirSolicitud" styleClass="nav"/>
            <Button text="%vista.servicios" onAction="#abrirServicios" styleClass="nav"/>
            <Button text="%vista.mis.viajes" onAction="#abrirViajes" styleClass="nav"/>
            <Button text="%vista.panel.conductor" onAction="#abrirPanel" styleClass="nav"/>
            <Button text="%vista.mis.vehiculos" onAction="#abrirRegistroConductor" styleClass="nav"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="%vista.tus.viajes.quedan.guardados.al.cerrar" styleClass="small" wrapText="true"/>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="20" styleClass="page">
                    <Label text="%vista.mis.viajes" styleClass="title" wrapText="true"/>
                    <Label text="%vista.consulta.solicitudes.recorridos.y.viajes.terminados" styleClass="muted" wrapText="true"/>
                    <VBox spacing="16" styleClass="card">
                        <VBox spacing="16" styleClass="field-group" HBox.hgrow="ALWAYS" minWidth="0">
                            <Label text="%vista.mostrar.viajes.como" styleClass="field-label" wrapText="true"/>
                            <ComboBox fx:id="rolConsulta" promptText="%vista.cliente.o.conductor" maxWidth="Infinity"/>
                        </VBox>
                        <ListView fx:id="listaViajes" prefHeight="380">
                            <placeholder>
                                <Label text="%vista.todavia.no.hay.viajes.para.este.rol" styleClass="muted" wrapText="true"/>
                            </placeholder>
                        </ListView>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Button text="%vista.ver.detalle.del.seleccionado" onAction="#verDetalle" styleClass="primary"/>
                            <Button text="%vista.actualizar" onAction="#actualizarViajes" styleClass="secondary"/>
                        </HBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <Label text="" styleClass="feedback" wrapText="true" fx:id="mensaje" maxWidth="Infinity"/>
    </bottom>
</BorderPane>