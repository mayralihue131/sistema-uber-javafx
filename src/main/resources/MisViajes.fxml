<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="12">
                    <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                    <Label text="%vista.mis.viajes" style="-fx-text-fill: #1565c0; -fx-font-size: 24px; -fx-font-weight: bold;" wrapText="true"/>
                    <Label text="%vista.consulta.solicitudes.recorridos.y.viajes.terminados" wrapText="true"/>
                    <VBox spacing="8">
                        <VBox spacing="16" HBox.hgrow="ALWAYS" minWidth="0">
                            <Label text="%vista.mostrar.viajes.como" wrapText="true"/>
                            <ComboBox fx:id="rolConsulta" promptText="%vista.cliente.o.conductor" maxWidth="Infinity"/>
                        </VBox>
                        <ListView fx:id="listaViajes" prefHeight="380">
                            <placeholder>
                                <Label text="%vista.todavia.no.hay.viajes.para.este.rol" wrapText="true"/>
                            </placeholder>
                        </ListView>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Button text="%vista.ver.detalle.del.seleccionado" onAction="#verDetalle"/>
                            <Button text="%vista.actualizar" onAction="#actualizarViajes"/>
                        </HBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <Label text="" wrapText="true" fx:id="mensaje" maxWidth="Infinity">
            <BorderPane.margin><Insets top="4" right="20" bottom="8" left="20"/></BorderPane.margin>
        </Label>
    </bottom>
</BorderPane>