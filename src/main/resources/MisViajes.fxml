<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" prefWidth="1080" prefHeight="780" styleClass="app" stylesheets="@uber.css">
 <top><HBox spacing="16" alignment="CENTER_LEFT" styleClass="topbar"><Label text="SISTEMA UBER" styleClass="brand" wrapText="true"/><Region HBox.hgrow="ALWAYS"/><Label text="" styleClass="user" wrapText="true" fx:id="nombreSesion"/><Button text="Cambiar cuenta" onAction="#cerrarSesion" styleClass="secondary"/></HBox></top>
 <left><VBox spacing="8" prefWidth="196" styleClass="sidebar"><Label text="TU ESPACIO" styleClass="eyebrow" wrapText="true"/><Button text="Inicio" onAction="#abrirMenu" styleClass="nav"/><Button text="Solicitar viaje" onAction="#abrirSolicitud" styleClass="nav"/><Button text="Servicios" onAction="#abrirServicios" styleClass="nav"/><Button text="Mis viajes" onAction="#abrirViajes" styleClass="nav"/><Button text="Panel conductor" onAction="#abrirPanel" styleClass="nav"/><Button text="Mis vehículos" onAction="#abrirRegistroConductor" styleClass="nav"/><Region VBox.vgrow="ALWAYS"/><Label text="Tus viajes quedan guardados al cerrar." styleClass="small" wrapText="true"/></VBox></left>
 <center><ScrollPane fitToWidth="true"><content><VBox spacing="20" styleClass="page"><Label text="Mis viajes" styleClass="title" wrapText="true"/><Label text="Consultá solicitudes, recorridos y viajes terminados." styleClass="muted" wrapText="true"/><VBox spacing="16" styleClass="card"><VBox spacing="16" styleClass="field-group" HBox.hgrow="ALWAYS" minWidth="0"><Label text="Mostrar viajes como" styleClass="field-label" wrapText="true"/><ComboBox fx:id="rolConsulta" promptText="Cliente o conductor" maxWidth="Infinity"/></VBox><ListView fx:id="listaViajes" prefHeight="380"><placeholder><Label text="Todavía no hay viajes para este rol." styleClass="muted" wrapText="true"/></placeholder></ListView><HBox spacing="12" alignment="CENTER_LEFT"><Button text="Ver detalle del seleccionado" onAction="#verDetalle" styleClass="primary"/><Button text="Actualizar" onAction="#actualizarViajes" styleClass="secondary"/></HBox></VBox></VBox></content></ScrollPane></center><bottom><Label text="" styleClass="feedback" wrapText="true" fx:id="mensaje" maxWidth="Infinity"/></bottom></BorderPane>