 <top><HBox spacing="16" alignment="CENTER_LEFT" styleClass="topbar"><Label text="SISTEMA UBER" styleClass="brand" wrapText="true"/><Region HBox.hgrow="ALWAYS"/><Label text="" styleClass="user" wrapText="true" fx:id="nombreSesion"/><Button text="Cambiar cuenta" onAction="#cerrarSesion" styleClass="secondary"/></HBox></top>
 <left><VBox spacing="8" prefWidth="196" styleClass="sidebar"><Label text="TU ESPACIO" styleClass="eyebrow" wrapText="true"/><Button text="Inicio" onAction="#abrirMenu" styleClass="nav"/><Button text="Solicitar viaje" onAction="#abrirSolicitud" styleClass="nav"/><Button text="Servicios" onAction="#abrirServicios" styleClass="nav"/><Button text="Mis viajes" onAction="#abrirViajes" styleClass="nav"/><Button text="Panel conductor" onAction="#abrirPanel" styleClass="nav"/><Button text="Mis vehículos" onAction="#abrirRegistroConductor" styleClass="nav"/><Region VBox.vgrow="ALWAYS"/><Label text="Tus viajes quedan guardados al cerrar." styleClass="small" wrapText="true"/></VBox></left>
 <center><ScrollPane fitToWidth="true"><content><VBox spacing="20" styleClass="page"><Label text="¿A dónde vamos hoy?" styleClass="title" wrapText="true"/><Label text="Elegí cómo querés usar Sistema Uber." styleClass="muted" wrapText="true"/><VBox spacing="16" styleClass="hero"><Label text="" styleClass="hero-title" wrapText="true" fx:id="saludo"/><Label text="Pedí un viaje, elegí tu servicio y seguí cada etapa desde el detalle." styleClass="muted" wrapText="true"/><HBox spacing="12" alignment="CENTER_LEFT"><Button text="Solicitar un viaje" onAction="#abrirSolicitud" styleClass="primary"/><Button text="Ver mis viajes" onAction="#abrirViajes" styleClass="secondary"/></HBox></VBox><HBox spacing="12" alignment="CENTER_LEFT"><VBox spacing="16" styleClass="card"><Label text="" styleClass="stat" wrapText="true" fx:id="cantidadViajes"/><Label text="Viajes como cliente" styleClass="muted" wrapText="true"/></VBox><VBox spacing="16" styleClass="card"><Label text="" styleClass="stat" wrapText="true" fx:id="cantidadActivos"/><Label text="Viajes activos" styleClass="muted" wrapText="true"/></VBox></HBox><VBox spacing="16" styleClass="card"><Label text="" styleClass="section" wrapText="true" fx:id="resumenActivo"/><Label text="" styleClass="muted" wrapText="true" fx:id="explicacionActivo"/><Button text="Ver mi viaje activo" onAction="#verActivo" styleClass="primary" fx:id="btnVerActivo"/></VBox><VBox spacing="16" styleClass="card"><Label text="También podés conducir" styleClass="section" wrapText="true"/><Label text="Registrá tu vehículo o entrá al panel para recibir solicitudes compatibles." styleClass="muted" wrapText="true"/><HBox spacing="12" alignment="CENTER_LEFT"><Button text="Ir al panel" onAction="#abrirPanel" styleClass="secondary"/><Button text="Habilitarme / agregar vehículo" onAction="#abrirRegistroConductor" styleClass="secondary"/></HBox></VBox></VBox></content></ScrollPane></center><bottom><Label text="" styleClass="feedback" wrapText="true" fx:id="mensaje" maxWid