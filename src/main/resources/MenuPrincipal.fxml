<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" prefWidth="1080" prefHeight="780" styleClass="app" stylesheets="@uber.css">
    <top>
        <HBox spacing="16" alignment="CENTER_LEFT" styleClass="topbar">
            <Label text="%vista.sistema.uber" styleClass="brand" wrapText="true"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="" styleClass="user" wrapText="true" fx:id="nombreSesion"/>
            <Button text="%vista.cambiar.cuenta" onAction="#cerrarSesion" styleClass="secondary"/>
        </HBox>
    </top>
    <left>
        <VBox spacing="8" prefWidth="196" styleClass="sidebar">
            <Label text="%vista.tu.espacio" styleClass="eyebrow" wrapText="true"/>
            <Button text="%vista.inicio" onAction="#abrirMenu" styleClass="nav"/>
            <Button text="%vista.solicitar.viaje" onAction="#abrirSolicitud" styleClass="nav"/>
            <Button text="%vista.servicios" onAction="#abrirServicios" styleClass="nav"/>
            <Button text="%vista.mis.viajes" onAction="#abrirViajes" styleClass="nav"/>
            <Button text="%vista.panel.conductor" onAction="#abrirPanel" styleClass="nav"/>
            <Button text="%vista.mis.vehiculos" onAction="#abrirRegistroConductor" styleClass="nav"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="%vista.tus.viajes.quedan.guardados.al.cerrar" styleClass="small" wrapText="true"/>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="20" styleClass="page">
                    <Label text="%vista.a.donde.vamos.hoy" styleClass="title" wrapText="true"/>
                    <Label text="%vista.elegi.como.queres.usar.sistema.uber" styleClass="muted" wrapText="true"/>
                    <VBox spacing="16" styleClass="hero">
                        <Label text="" styleClass="hero-title" wrapText="true" fx:id="saludo"/>
                        <Label text="%vista.pedi.un.viaje.elegi.tu.servicio.y" styleClass="muted" wrapText="true"/>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Button text="%vista.solicitar.un.viaje" onAction="#abrirSolicitud" styleClass="primary"/>
                            <Button text="%vista.ver.mis.viajes" onAction="#abrirViajes" styleClass="secondary"/>
                        </HBox>
                    </VBox>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <VBox spacing="16" styleClass="card">
                            <Label text="" styleClass="stat" wrapText="true" fx:id="cantidadViajes"/>
                            <Label text="%vista.viajes.como.cliente" styleClass="muted" wrapText="true"/>
                        </VBox>
                        <VBox spacing="16" styleClass="card">
                            <Label text="" styleClass="stat" wrapText="true" fx:id="cantidadActivos"/>
                            <Label text="%vista.viajes.activos" styleClass="muted" wrapText="true"/>
                        </VBox>
                    </HBox>
                    <VBox spacing="16" styleClass="card">
                        <Label text="" styleClass="section" wrapText="true" fx:id="resumenActivo"/>
                        <Label text="" styleClass="muted" wrapText="true" fx:id="explicacionActivo"/>
                        <Button text="%vista.ver.mi.viaje.activo" onAction="#verActivo" styleClass="primary" fx:id="btnVerActivo"/>
                    </VBox>
                    <VBox spacing="16" styleClass="card">
                        <Label text="%vista.tambien.podes.conducir" styleClass="section" wrapText="true"/>
                        <Label text="%vista.registra.tu.vehiculo.o.entra.al.panel" styleClass="muted" wrapText="true"/>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Button text="%vista.ir.al.panel" onAction="#abrirPanel" styleClass="secondary"/>
                            <Button text="%vista.habilitarme.agregar.vehiculo" onAction="#abrirRegistroConductor" styleClass="secondary"/>
                        </HBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <Label text="" styleClass="feedback" wrapText="true" fx:id="mensaje" maxWidth="Infinity"/>
    </bottom>
</BorderPane>