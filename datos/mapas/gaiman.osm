  <tag k="amenity" v="place_of_worship"/>
  <tag k="denomination" v="protestant"/>
  <tag k="name" v="Capilla Bethel Nueva"/>
  <tag k="note" v="Su construcción comenzó en 1912 y fue inaugurada en 1914.Fue construida por Jack Jones y los trabajos de carpintería por Llewelyn Griffiths y Egryn Evans. Posee un aspecto “neogótico”, con sus ventanas frontales en forma de ojiva."/>
  <tag k="religion" v="christian"/>
  <tag k="website" v="https://www.flickr.com/photos/14563177@N07/2376650227/"/>
 </node>
 <node id="2524659152" visible="true" version="11" changeset="90670422" timestamp="2020-09-10T02:14:46Z" user="serock" uid="1810448" lat="-43.2865831" lon="-65.4980038">
  <tag k="name" v="Museo Antropologico"/>
  <tag k="note" v="Se exhiben cráneos, puntas de flecha, boleadoras, morteros junto a la historia de la relación entre aborígenes, españoles y colonos galeses. Visitas guiadas desde la Dirección de Turismo."/>
  <tag k="operator:type" v="public"/>
  <tag k="tourism" v="museum"/>
  <tag k="website" v="https://ssl.panoramio.com/photo/61306966"/>
  <tag k="wikidata" v="Q84509824"/>
 </node>
